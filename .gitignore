# BGM library: user-supplied tracks only, never bundled with the repo.
# Case-insensitive so "Track.MP3" cannot slip past; sidecar .json stays tracked.
backend/assets/music/*.[mM][pP]3
backend/assets/music/*.[wW][aA][vV]
backend/assets/music/*.[mM]4[aA]
backend/assets/music/*.[oO][gG][gG]

# Exception: lofi.mp3 is the CC0 open-lofi track "Moon Over Red Dunes" (see docs/ASSETS.md).
!backend/assets/music/lofi.mp3

# Exception: one original, generated placeholder BGM IS committed on purpose.
# Regenerate it with tools/generate_sfx.py; license is in its .json sidecar.
!backend/assets/music/ambient-pad.mp3

# Generated test SFX (case-insensitive); sidecar .json stays tracked.
backend/assets/sfx/*.[wW][aA][vV]
backend/assets/sfx/*.[mM][pP]3
backend/assets/sfx/*.[mM]4[aA]
backend/assets/sfx/*.[oO][gG][gG]
backend/assets/sfx/*.[fF][lL][aA][cC]

# One-click launcher runtime: per-service logs and tracked PIDs.
logs/
.run/

# Local launcher overrides (e.g. VLLM_MODEL); never commit personal paths.
launcher.env.local.bat

# Third-party model binaries with no documented permissive license (local only).
# Unreferenced by the app; kept on disk but not published.
backend/assets/models/*.onnx
backend/assets/models/*.caffemodel

# One-off host scripts that contain personal/absolute developer paths.
# Kept locally for reference but never published.
Start-OpenHands.bat
backend/fix_paths.py
script.py

# Proprietary Monotype font: kept on disk for local renders but never published.
# The repository ships the SIL OFL 1.1 Anton font instead (see docs/ASSETS.md).
backend/assets/fonts/impact.ttf