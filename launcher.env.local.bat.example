@echo off
rem Local launcher overrides - template.
rem Copy this file to launcher.env.local.bat (gitignored) and adjust the line
rem below to point at your own model directory. The copied file is never
rem committed, so no personal absolute path ends up in the repository.
rem If VLLM_MODEL is left unset, services\vllm\start_vllm.bat uses its own
rem built-in fallback path.

rem set "VLLM_MODEL=C:\models\meissa-7b-awq"
